generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [uuidOssp(map: "uuid-ossp")]
}

model WarehouseConfig {
  id                Int       @id @unique(map: "idx_warehouse_config_singleton") @default(1)
  warehouseName     String?   @default("Mi Almacén") @map("warehouse_name") @db.VarChar(255)
  totalCapacity     Int?      @default(1000) @map("total_capacity")
  unitsOfMeasure    String?   @default("m2") @map("units_of_measure") @db.VarChar(50)
  totalZones        Int?      @default(2) @map("total_zones")
  expiryWarningDays Int?      @default(7) @map("expiry_warning_days")
  maxHealthScore    Int?      @default(100) @map("max_health_score")
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("warehouse_config")
}

model Zone {
  id                    String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code                  String    @unique @db.VarChar(50)
  name                  String    @db.VarChar(255)
  maxCapacity           Int       @map("max_capacity")
  unitsOfMeasure        String?   @default("m2") @map("units_of_measure") @db.VarChar(50)
  zoneType              String?   @default("normal") @map("zone_type") @db.VarChar(50)
  temperatureControlled Boolean?  @default(false) @map("temperature_controlled")
  active                Boolean?  @default(true)
  createdAt             DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([code], map: "idx_zones_code")
  @@index([active], map: "idx_zones_active")
  @@map("zones")
}

model Product {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sku            String          @unique @db.VarChar(50)
  name           String          @db.VarChar(255)
  category       String?         @db.VarChar(100)
  barcode        String?         @db.VarChar(100)
  currentStock   Int?            @default(0) @map("current_stock")
  minStock       Int?            @default(10) @map("min_stock")
  maxStock       Int?            @default(100) @map("max_stock")
  unitPrice      Decimal         @map("unit_price") @db.Decimal(10, 2)
  currency       String?         @default("EUR") @db.VarChar(3)
  location       String?         @db.VarChar(100)
  zone           String?         @db.VarChar(50)
  numberOfUnits  String?         @map("number_of_units") @db.VarChar(100)
  expirationDate DateTime?       @map("expiration_date") @db.Date
  supplier       String?         @db.VarChar(255)
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamp(6)
  dateAdded      DateTime?       @default(now()) @map("date_added") @db.Timestamp(6)
  updatedAt      DateTime?       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  alerts         Alert[]
  stockMovements StockMovement[]

  @@index([category], map: "idx_products_category")
  @@index([location], map: "idx_products_location")
  @@index([expirationDate], map: "idx_products_expiration")
  @@index([currentStock], map: "idx_products_stock")
  @@index([deletedAt], map: "idx_products_deleted")
  @@index([sku], map: "idx_products_sku")
  @@index([name(ops: raw("gin_trgm_ops"))], map: "idx_products_name_trgm", type: Gin)
  @@map("products")
}

model StockMovement {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productId      String?   @map("product_id") @db.Uuid
  movementType   String    @map("movement_type") @db.VarChar(20)
  quantity       Int
  quantityBefore Int?      @map("quantity_before")
  quantityAfter  Int?      @map("quantity_after")
  reference      String?   @db.VarChar(100)
  documentType   String?   @map("document_type") @db.VarChar(50)
  costPerUnit    Decimal?  @map("cost_per_unit") @db.Decimal(10, 2)
  totalCost      Decimal?  @map("total_cost") @db.Decimal(10, 2)
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  notes          String?
  product        Product?  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([productId], map: "idx_movements_product")
  @@index([movementType], map: "idx_movements_type")
  @@index([createdAt], map: "idx_movements_date")
  @@index([reference], map: "idx_movements_reference")
  @@map("stock_movements")
}

model Alert {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productId     String?   @map("product_id") @db.Uuid
  alertType     String    @map("alert_type") @db.VarChar(20)
  category      String?   @db.VarChar(50)
  title         String    @db.VarChar(255)
  message       String
  resolved      Boolean?  @default(false)
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamp(6)
  resolvedBy    String?   @map("resolved_by") @db.Uuid
  autoGenerated Boolean?  @default(true) @map("auto_generated")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  product       Product?  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([productId], map: "idx_alerts_product")
  @@index([alertType], map: "idx_alerts_type")
  @@index([category], map: "idx_alerts_category")
  @@index([resolved], map: "idx_alerts_resolved")
  @@index([createdAt], map: "idx_alerts_created")
  @@map("alerts")
}

model Invoice {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  invoiceNumber    String    @unique @map("invoice_number") @db.VarChar(100)
  supplierName     String    @map("supplier_name") @db.VarChar(255)
  nifCif           String?   @map("nif_cif") @db.VarChar(50)
  subtotal         Decimal   @db.Decimal(10, 2)
  taxAmount        Decimal?  @default(0) @map("tax_amount") @db.Decimal(10, 2)
  totalAmount      Decimal   @map("total_amount") @db.Decimal(10, 2)
  currency         String?   @default("EUR") @db.VarChar(3)
  invoiceDate      DateTime  @map("invoice_date") @db.Date
  limitDate        DateTime  @map("limit_date") @db.Date
  paidDate         DateTime? @map("paid_date") @db.Date
  status           String?   @default("pendiente") @db.VarChar(20)
  paymentMethod    String?   @map("payment_method") @db.VarChar(50)
  paymentReference String?   @map("payment_reference") @db.VarChar(100)
  filePath         String?   @map("file_path")
  notes            String?
  deletedAt        DateTime? @map("deleted_at") @db.Timestamp(6)
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([invoiceNumber], map: "idx_invoices_number")
  @@index([supplierName], map: "idx_invoices_supplier")
  @@index([limitDate], map: "idx_invoices_due_date")
  @@index([status], map: "idx_invoices_status")
  @@index([deletedAt], map: "idx_invoices_deleted")
  @@map("invoices")
}

model Task {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title      String    @db.VarChar(255)
  priority   String?   @default("medium") @db.VarChar(20)
  assignedTo String?   @map("assigned_to") @db.VarChar(255)
  supervisor String?   @db.VarChar(255)
  phone      String?   @db.VarChar(50)
  status     String?   @default("pending") @db.VarChar(20)
  dueDate    DateTime? @map("due_date") @db.Date
  notes      String?
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([priority], map: "idx_tasks_priority")
  @@index([status], map: "idx_tasks_status")
  @@map("tasks")
}
