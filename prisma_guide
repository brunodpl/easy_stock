## 3. Schema Design for Easy-Stock

Based on your requirements (dashboard, products, alerts, automation), here's a recommended schema structure:

### `prisma/schema.prisma`

```prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Product Management
model Product {
  id                String      @id @default(cuid())
  sku               String      @unique
  name              String
  description       String?
  category          String
  currentStock      Int         @default(0)
  minStockLevel     Int         @default(10)
  maxStockLevel     Int?
  reorderPoint      Int         @default(20)
  unitPrice         Decimal     @db.Decimal(10, 2)
  location          String?     // Warehouse location
  supplier          String?
  
  // Timestamps
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  // Relations
  stockMovements    StockMovement[]
  alerts            Alert[]
  invoiceItems      InvoiceItem[]
  
  @@index([sku])
  @@index([category])
}

// Stock Movement Tracking
model StockMovement {
  id                String      @id @default(cuid())
  productId         String
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  movementType      MovementType // IN, OUT, ADJUSTMENT
  quantity          Int
  previousStock     Int
  newStock          Int
  reason            String?
  reference         String?     // Order number, invoice reference, etc.
  
  // Who performed the action
  performedBy       String?
  performedAt       DateTime    @default(now())
  
  // Voice interaction tracking
  isVoiceInput      Boolean     @default(false)
  voiceTranscript   String?
  
  @@index([productId])
  @@index([performedAt])
}

enum MovementType {
  IN              // Stock received
  OUT             // Stock sold/shipped
  ADJUSTMENT      // Manual adjustment
  RETURN          // Product return
}

// Alert System
model Alert {
  id                String       @id @default(cuid())
  productId         String?
  product           Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  severity          AlertSeverity
  type              AlertType
  message           String
  description       String?
  
  isResolved        Boolean      @default(false)
  resolvedAt        DateTime?
  resolvedBy        String?
  
  contactPhone      String?      // Superior contact for urgent alerts
  
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  
  @@index([severity])
  @@index([isResolved])
  @@index([createdAt])
}

enum AlertSeverity {
  CRITICAL        // Grave - Immediate action required
  WARNING         // Atención - Action needed soon
  INFO            // Leve - Informational
  NOTICE          // Informativa - General notice
}

enum AlertType {
  LOW_STOCK
  OUT_OF_STOCK
  OVERSTOCK
  EXPIRING_SOON
  DATA_INCONSISTENCY
  SYSTEM
}

// Invoice Management
model Invoice {
  id                String        @id @default(cuid())
  invoiceNumber     String        @unique
  customerName      String?
  customerEmail     String?
  customerPhone     String?
  
  status            InvoiceStatus @default(PENDING)
  totalAmount       Decimal       @db.Decimal(10, 2)
  
  issuedDate        DateTime      @default(now())
  dueDate           DateTime?
  paidDate          DateTime?
  
  // Relations
  items             InvoiceItem[]
  
  @@index([status])
  @@index([dueDate])
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model InvoiceItem {
  id                String    @id @default(cuid())
  invoiceId         String
  invoice           Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  productId         String
  product           Product   @relation(fields: [productId], references: [id])
  
  quantity          Int
  unitPrice         Decimal   @db.Decimal(10, 2)
  totalPrice        Decimal   @db.Decimal(10, 2)
  
  @@index([invoiceId])
  @@index([productId])
}

// Task Management & Priorities
model Task {
  id                String      @id @default(cuid())
  title             String
  description       String?
  priority          TaskPriority
  status            TaskStatus  @default(PENDING)
  
  assignedTo        String?
  dueDate           DateTime?
  completedAt       DateTime?
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  @@index([priority])
  @@index([status])
  @@index([dueDate])
}

enum TaskPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Warehouse Space Management
model WarehouseSpace {
  id                String    @id @default(cuid())
  name              String    @unique
  totalCapacity     Int       // Total space units
  usedCapacity      Int       @default(0)
  location          String?
  
  updatedAt         DateTime  @updatedAt
}

// Data Inconsistency Log (for LLM resolution)
model DataInconsistency {
  id                String    @id @default(cuid())
  csvData           String    @db.Text // Original CSV data
  detectedIssues    String    @db.Text // JSON array of issues
  
  isResolved        Boolean   @default(false)
  resolution        String?   @db.Text // LLM suggested resolution
  appliedFix        Boolean   @default(false)
  
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?
  
  @@index([isResolved])
  @@index([createdAt])
}
```

### Schema Organization for Large Projects

For better maintainability, consider organizing schemas by feature:

```
prisma/
├── schema/
│   ├── base.prisma          # Datasource and generator config
│   ├── product.prisma       # Product models
│   ├── alert.prisma         # Alert models
│   ├── invoice.prisma       # Invoice models
│   └── task.prisma          # Task models
```

Then combine them with a script in `package.json`:

```json
{
  "scripts": {
    "prisma:build": "cat prisma/schema/*.prisma > prisma/schema.prisma",
    "prisma:generate": "npm run prisma:build && prisma generate",
    "prisma:migrate": "npm run prisma:build && prisma migrate dev"
  }
}
```

