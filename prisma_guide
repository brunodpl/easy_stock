## 6. Query Patterns for Easy-Stock Features

### Dashboard - Product Table with Alerts

```typescript
// Get all products with alert counts
async function getDashboardProducts() {
  const products = await prisma.product.findMany({
    include: {
      alerts: {
        where: { isResolved: false },
        select: { id: true, severity: true }
      },
      _count: {
        select: { stockMovements: true }
      }
    },
    orderBy: { updatedAt: 'desc' }
  })
  
  return products.map(product => ({
    ...product,
    alertCount: product.alerts.length,
    hasLowStock: product.currentStock <= product.minStockLevel,
    stockHealth: calculateStockHealth(product)
  }))
}

function calculateStockHealth(product: any): number {
  if (product.currentStock === 0) return 0
  if (product.currentStock <= product.minStockLevel) return 30
  if (product.currentStock <= product.reorderPoint) return 60
  return 100
}
```

### Dashboard - Alert System

```typescript
// Get alerts grouped by severity
async function getAlertSummary() {
  const alerts = await prisma.alert.groupBy({
    by: ['severity'],
    where: { isResolved: false },
    _count: { id: true }
  })
  
  return {
    critical: alerts.find(a => a.severity === 'CRITICAL')?._count.id || 0,
    warning: alerts.find(a => a.severity === 'WARNING')?._count.id || 0,
    info: alerts.find(a => a.severity === 'INFO')?._count.id || 0,
    notice: alerts.find(a => a.severity === 'NOTICE')?._count.id || 0
  }
}

// Get recent unresolved alerts
async function getRecentAlerts() {
  return prisma.alert.findMany({
    where: { isResolved: false },
    include: {
      product: {
        select: { id: true, name: true, sku: true }
      }
    },
    orderBy: [
      { severity: 'asc' }, // CRITICAL first
      { createdAt: 'desc' }
    ],
    take: 10
  })
}
```

### Warehouse Space Calculation

```typescript
// Calculate warehouse occupancy percentage
async function getWarehouseOccupancy() {
  const spaces = await prisma.warehouseSpace.findMany()
  
  const total = spaces.reduce((sum, s) => sum + s.totalCapacity, 0)
  const used = spaces.reduce((sum, s) => sum + s.usedCapacity, 0)
  
  return {
    totalCapacity: total,
    usedCapacity: used,
    percentage: total > 0 ? (used / total) * 100 : 0
  }
}
```

### Next Week Invoices

```typescript
// Get invoices due in the next 7 days
async function getUpcomingInvoices() {
  const today = new Date()
  const nextWeek = new Date()
  nextWeek.setDate(today.getDate() + 7)
  
  return prisma.invoice.findMany({
    where: {
      dueDate: {
        gte: today,
        lte: nextWeek
      },
      status: { in: ['PENDING', 'OVERDUE'] }
    },
    include: {
      items: {
        include: {
          product: {
            select: { name: true, sku: true }
          }
        }
      }
    },
    orderBy: { dueDate: 'asc' }
  })
}
```

### Stock Movement Tracking (Voice Integration)

```typescript
// Record stock movement with voice support
async function recordStockMovement(data: {
  productId: string
  movementType: 'IN' | 'OUT' | 'ADJUSTMENT'
  quantity: number
  reason?: string
  performedBy?: string
  isVoiceInput?: boolean
  voiceTranscript?: string
}) {
  return prisma.$transaction(async (tx) => {
    // Get current product stock
    const product = await tx.product.findUnique({
      where: { id: data.productId }
    })
    
    if (!product) throw new Error('Product not found')
    
    // Calculate new stock
    let newStock = product.currentStock
    if (data.movementType === 'IN') {
      newStock += data.quantity
    } else if (data.movementType === 'OUT') {
      newStock -= data.quantity
    } else {
      newStock = data.quantity // ADJUSTMENT sets absolute value
    }
    
    // Create stock movement record
    const movement = await tx.stockMovement.create({
      data: {
        productId: data.productId,
        movementType: data.movementType,
        quantity: data.quantity,
        previousStock: product.currentStock,
        newStock: newStock,
        reason: data.reason,
        performedBy: data.performedBy,
        isVoiceInput: data.isVoiceInput || false,
        voiceTranscript: data.voiceTranscript
      }
    })
    
    // Update product stock
    await tx.product.update({
      where: { id: data.productId },
      data: { currentStock: newStock }
    })
    
    // Check if alert needed
    if (newStock <= product.minStockLevel) {
      await tx.alert.create({
        data: {
          productId: data.productId,
          severity: newStock === 0 ? 'CRITICAL' : 'WARNING',
          type: newStock === 0 ? 'OUT_OF_STOCK' : 'LOW_STOCK',
          message: `${product.name} stock level critical`,
          description: `Current stock: ${newStock}, Min level: ${product.minStockLevel}`
        }
      })
    }
    
    return movement
  })
}
```

